# Copy to .env and fill in values for local development.
# These override any config file settings.

# ZBXCTL_URL=https://zabbix.example.com
# ZBXCTL_API_TOKEN=your-api-token-here
# ZBXCTL_USERNAME=Admin
# ZBXCTL_PASSWORD=zabbix
# ZBXCTL_CONTEXT=prod
# ZBXCTL_INSECURE=false
# ZBXCTL_CA_FILE=/path/to/ca.pem
